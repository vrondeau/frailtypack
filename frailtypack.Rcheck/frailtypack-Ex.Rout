> # Monte-Carlo samples.
> GJFM.ssize(
+   power = 0.80, ni = 5,
+   FUP = 6, Acc.Dur = 0.5, medianR.H0 = 2, medianD.H0 = 5,
+   betaR.HA = log(0.70), betaD.HA = log(0.80), theta = 0.5, eta = 0.75,
+   samples.mc = 1e5
+ ) # sample size ~ 705 patients / ~ approx 4 min.


